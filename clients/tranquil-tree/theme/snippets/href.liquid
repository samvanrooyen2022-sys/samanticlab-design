{%- comment -%}
  Turns a link setting into a URL. An empty link falls back to one of the
  site-wide links in Theme settings > Kiki's links.
  Usage: {% render 'href', url: block.settings.link, fallback: 'shift', text: 'Hi Kiki' %}
  fallback: shift | quiz | whatsapp | retreats | links | account | bestsellers
{%- endcomment -%}
{%- liquid
  assign key = url | default: fallback
  case key
    when 'custom', blank
      echo '#'
    when 'shift', 'retreats'
      if key == 'shift'
        assign own = settings.shift_url
        assign ask = "Hi Kiki, I'd like to book a Shift Consultation."
        assign subject = 'Booking a Shift Consultation'
      else
        assign own = settings.retreats_url
        assign ask = "Hi Kiki, when is your next retreat?"
        assign subject = 'Your next retreat'
      endif
      comment
        No link set yet: ask Kiki on WhatsApp, or by email if there's no number either.
      endcomment
      if own != blank and own != '#'
        echo own
      elsif settings.whatsapp != blank
        assign t = ask | url_encode
        echo 'https://wa.me/' | append: settings.whatsapp | append: '?text=' | append: t
      else
        assign sub = subject | url_encode | replace: '+', '%20'
        assign t = ask | url_encode | replace: '+', '%20'
        echo 'mailto:' | append: shop.email | append: '?subject=' | append: sub | append: '&body=' | append: t
      endif
    when 'quiz'
      echo settings.quiz_url | default: '#'
    when 'links'
      echo '/pages/links'
    when 'account'
      echo routes.account_url
    when 'bestsellers'
      echo routes.all_products_collection_url | append: '?sort_by=best-selling'
    when 'whatsapp'
      echo 'https://wa.me/' | append: settings.whatsapp
      if text != blank
        assign t = text | url_encode
        echo '?text=' | append: t
      endif
    else
      echo key | default: '#'
  endcase
-%}
