<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="{{ settings.c_paper }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
  {%- endif -%}
  {%- liquid
    assign title = page_title
    if template.name == 'index' and template.suffix == 'shift'
      assign title = 'Book a Shift Consultation'
    elsif template.name == 'index' and template.suffix == 'retreats'
      assign title = 'Retreats'
    endif
  -%}
  <title>{{ title }}{% if current_page != 1 %} – page {{ current_page }}{% endif %}{% unless title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
  {%- if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {% render 'meta-tags' %}

  {% render 'theme-styles' %}
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  {%- if settings.custom_css != blank -%}<style>{{ settings.custom_css }}</style>{%- endif -%}
  <script>document.documentElement.classList.add('js');</script>
  {% render 'theme-globals' %}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>

  {{ content_for_header }}
</head>
<body class="tmpl-{{ template.name }}{% unless settings.motion %} no-motion{% endunless %}">
  {% render 'icon-sprite' %}
  <a class="sr skip" href="#main">Skip to content</a>

  {% sections 'header-group' %}

  <main id="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% render 'overlays' %}
  {% section 'cart-drawer' %}
</body>
</html>
