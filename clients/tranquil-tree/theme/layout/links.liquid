<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="{{ settings.c_paper }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
  {%- endif -%}
  <title>{{ page_title }}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
  {%- if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {% render 'meta-tags' %}

  {% render 'theme-styles' %}
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  {%- if settings.custom_css != blank -%}<style>{{ settings.custom_css }}</style>{%- endif -%}
  <script>document.documentElement.classList.add('js');</script>
  {% render 'theme-globals' %}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>

  {{ content_for_header }}
</head>
{%- comment -%} The link-in-bio page: no header or footer, but the same cart and look. {%- endcomment -%}
<body class="tmpl-links{% unless settings.motion %} no-motion{% endunless %}">
  {% render 'icon-sprite' %}
  <main id="main" class="links">
    {{ content_for_layout }}
  </main>
  {% render 'overlays' %}
  {% section 'cart-drawer' %}
</body>
</html>
