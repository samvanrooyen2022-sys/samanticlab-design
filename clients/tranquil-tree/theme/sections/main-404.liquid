<div class="wrap page-in" style="text-align:center;padding-block:96px">
  <h1 class="sig">{{ section.settings.heading }}</h1>
  <p class="lede" style="margin:16px auto 28px">{{ section.settings.text }}</p>
  <a class="btn" href="{{ routes.all_products_collection_url }}">Shop all products {% render 'icon', name: 'arrow-right' %}</a>
</div>
{% schema %}
{ "name": "Page not found", "settings": [
  { "type": "text", "id": "heading", "label": "Heading", "default": "This page has moved" },
  { "type": "text", "id": "text", "label": "Text", "default": "The link may be old. Everything Kiki sells is in the shop." }
] }
{% endschema %}
