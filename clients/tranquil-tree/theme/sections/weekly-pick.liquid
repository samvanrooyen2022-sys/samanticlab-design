{%- comment -%} "This week from Kiki": one product Kiki swaps whenever she posts. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign p = s.product
-%}
<section class="sec week-band" aria-labelledby="h-{{ section.id }}">
  <div class="wrap week">
    <a class="week-media" href="{{ p.url | default: '#' }}" aria-label="{{ p.title | default: 'This week' | escape }}">
      {%- if s.image != blank -%}
        <div class="ph has-img">{{ s.image | image_url: width: 1200 | image_tag: class: 'pi', widths: '480,800,1200', sizes: '(min-width: 1024px) 50vw, 100vw', loading: 'lazy' }}</div>
      {%- elsif p != blank -%}
        {% render 'product-media', product: p, sizes: '(min-width: 1024px) 50vw, 100vw' %}
      {%- else -%}
        <div class="ph">{% render 'icon', name: 'image' %}<span class="ph-cap">Pick this week's product</span></div>
      {%- endif -%}
    </a>
    <div class="week-copy">
      <h2 class="h2"{% if settings.motion %} data-words{% endif %}>{{ s.heading }}</h2>
      {%- if s.quote != blank -%}
        <div class="week-quote">
          <div class="ph avatar">
            {%- if s.avatar != blank -%}{{ s.avatar | image_url: width: 120 | image_tag: alt: 'Kiki', loading: 'lazy' }}{%- else -%}<img src="{{ 'kiki.webp' | asset_url }}" alt="Kiki" width="96" height="96" loading="lazy">{%- endif -%}
          </div>
          <p>{{ s.quote }}</p>
        </div>
      {%- endif -%}
      {%- if p != blank -%}
        <div class="week-buy">
          <div class="row"><h3>{{ p.title }}</h3>{% render 'price', product: p %}</div>
          <p class="card-does">{% render 'product-does', product: p, words: 24 %}</p>
          {% render 'buy-button', product: p, class: 'btn btn-w btn-wide' %}
          <a class="text-link" href="{{ p.url }}">{{ s.link_label }} {% render 'icon', name: 'arrow-right' %}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "This week from Kiki",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "This week's product" },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Empty uses the product photo. A photo from her post works best." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This week, from Kiki" },
    { "type": "textarea", "id": "quote", "label": "Kiki's reason for loving it", "default": "I take this every morning. It's the one thing I never run out of." },
    { "type": "image_picker", "id": "avatar", "label": "Kiki's round photo", "info": "Empty uses the photo that comes with the theme." },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "See everything about it" }
  ],
  "presets": [{ "name": "This week from Kiki" }]
}
{% endschema %}
