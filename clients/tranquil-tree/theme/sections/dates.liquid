<section class="sec" id="{{ section.settings.anchor | default: section.id }}" style="padding-top:{{ section.settings.pad_top }}px" aria-labelledby="h-{{ section.id }}">
  <div class="wrap">
    <div class="sec-head"><h2 class="h2" id="h-{{ section.id }}"{% if settings.motion %} data-words{% endif %}>{{ section.settings.heading }}</h2></div>
    <ul class="dates dates-big">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <div><b>{% render 'fill-text', text: block.settings.date %}</b><span>{% render 'fill-text', text: block.settings.place %}</span></div>
          <span class="status{% if block.settings.full %} full{% endif %}">{% if block.settings.full %}Fully booked{% else %}{% render 'fill-text', text: block.settings.note %}{% endif %}</span>
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.btn != blank -%}<div class="row-btns" style="margin-top:24px"><a class="btn btn-y" href="{% render 'href', url: section.settings.link, fallback: 'retreats-book' %}">{{ section.settings.btn }} {% render 'icon', name: 'arrow-right' %}</a></div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Dates",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Next dates" },
    { "type": "text", "id": "btn", "label": "Button", "default": "Ask about a place" },
    { "type": "url", "id": "link", "label": "Button link", "info": "Empty uses the Retreats booking link in Theme settings, or WhatsApp." },
    { "type": "text", "id": "anchor", "label": "Anchor name", "default": "dates" },
    { "type": "range", "id": "pad_top", "label": "Space above", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 0 }
  ],
  "blocks": [
    { "type": "date", "name": "Date", "settings": [
      { "type": "text", "id": "date", "label": "Date", "default": "[Date]" },
      { "type": "text", "id": "place", "label": "Place", "default": "[Place]" },
      { "type": "text", "id": "note", "label": "Note", "default": "[Spaces left]" },
      { "type": "checkbox", "id": "full", "label": "Fully booked", "default": false }
    ] }
  ],
  "presets": [{ "name": "Dates", "blocks": [ { "type": "date" } ] }]
}
{% endschema %}
