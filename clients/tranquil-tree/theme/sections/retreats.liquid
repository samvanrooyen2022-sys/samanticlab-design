{%- assign s = section.settings -%}
<section class="sec" id="{{ s.anchor | default: section.id }}" style="padding-top:{{ s.pad_top }}px" aria-labelledby="h-{{ section.id }}">
  <div class="wrap retreat">
    {%- if s.image != blank -%}
      <div class="ph has-img">{{ s.image | image_url: width: 1200 | image_tag: class: 'pi', widths: '480,800,1200', sizes: '(min-width: 768px) 50vw, 100vw', loading: 'lazy' }}</div>
    {%- else -%}
      <div class="ph soft">{% render 'icon', name: 'image' %}<span class="ph-cap">Retreat photo</span></div>
    {%- endif -%}
    <div class="retreat-copy">
      <h2 class="h2" id="h-{{ section.id }}">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="lede">{{ s.text }}</p>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="dates">
          {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}><span>{{ block.settings.label }}</span><span>{{ block.settings.date }}</span></li>{%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if s.btn != blank -%}<a class="text-link" href="{% render 'href', url: s.link, fallback: 'retreats' %}">{{ s.btn }} {% render 'icon', name: 'arrow-right' %}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Retreats",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Come away for a few days" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "btn", "label": "Link text", "default": "See the retreats" },
    { "type": "url", "id": "link", "label": "Link", "info": "Empty uses the Retreats link in Theme settings." },
    { "type": "text", "id": "anchor", "label": "Anchor name", "default": "retreats" },
    { "type": "range", "id": "pad_top", "label": "Space above", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 0 }
  ],
  "blocks": [
    { "type": "date", "name": "Date", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Next retreat" },
      { "type": "text", "id": "date", "label": "Date", "default": "Date to be announced" }
    ] }
  ],
  "presets": [{ "name": "Retreats", "blocks": [ { "type": "date" } ] }]
}
{% endschema %}
