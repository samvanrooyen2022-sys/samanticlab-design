{%- comment -%}
  "Goes well with": Shopify's own recommendations for this product.
  theme.js loads it after the page, so the page itself stays fast.
{%- endcomment -%}
<section class="sec recs" style="padding-top:0;padding-bottom:40px" data-recs data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.count }}&intent={{ section.settings.intent }}">
  <div class="wrap">
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="sec-head"><h2 class="h2">{{ section.settings.heading }}</h2></div>
      <div class="pairs">
        {%- for p in recommendations.products -%}
          {% render 'product-card', product: p, sizes: '(min-width: 768px) 30vw, 60vw' %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Goes well with",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Goes well with" },
    { "type": "range", "id": "count", "label": "Products", "min": 2, "max": 6, "step": 1, "default": 3 },
    { "type": "select", "id": "intent", "label": "Which products", "default": "related", "options": [
      { "value": "related", "label": "Similar products (automatic)" },
      { "value": "complementary", "label": "Complementary products (set in Search & Discovery app)" }
    ] }
  ],
  "presets": [{ "name": "Goes well with" }]
}
{% endschema %}
