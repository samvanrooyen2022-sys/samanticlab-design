{%- comment -%} Bestsellers row: swipes sideways on phones, six across on desktop. Any collection works. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign c = s.collection
-%}
<section class="sec" id="{{ s.anchor | default: section.id }}" style="padding-top:{{ s.pad_top }}px" aria-labelledby="h-{{ section.id }}">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="h2" id="h-{{ section.id }}"{% if settings.motion %} data-words{% endif %}>{{ s.heading }}</h2>
      {%- if s.link_label != blank -%}<a class="text-link" href="{% if c != blank %}{{ c.url }}{% else %}{% render 'href', fallback: 'bestsellers' %}{% endif %}">{{ s.link_label }} {% render 'icon', name: 'arrow-right' %}</a>{%- endif -%}
    </div>
    {%- if c != blank and c.products_count > 0 -%}
      <div class="rail" data-rail>
        {%- for p in c.products limit: s.count -%}
          {% render 'product-card', product: p, does: s.show_does, sizes: '(min-width: 1024px) 16vw, (min-width: 768px) 40vw, 68vw' %}
        {%- endfor -%}
      </div>
      <div class="rail-foot"><div class="rail-dots" data-rail-dots aria-hidden="true"></div></div>
    {%- else -%}
      {%- comment -%} No collection picked: her best-sellers in Shopify's sales order, loaded by theme.js. {%- endcomment -%}
      <div class="rail" data-rail data-feed-src="{{ routes.all_products_collection_url }}?sort_by=best-selling&section_id=feed-cards" data-feed-limit="{{ s.count }}">
        {%- for p in collections.all.products limit: s.count -%}
          {% render 'product-card', product: p, does: s.show_does, sizes: '(min-width: 1024px) 16vw, (min-width: 768px) 40vw, 68vw' %}
        {%- endfor -%}
      </div>
      <div class="rail-foot"><div class="rail-dots" data-rail-dots aria-hidden="true"></div></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product row",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people order from me most" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show her best-sellers, in Shopify's own sales order." },
    { "type": "range", "id": "count", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_does", "label": "Show the one-line description on phones", "default": true },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "See all bestsellers" },
    { "type": "text", "id": "anchor", "label": "Anchor name", "default": "bestsellers", "info": "Buttons can jump here with #bestsellers." },
    { "type": "range", "id": "pad_top", "label": "Space above", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 32 }
  ],
  "presets": [{ "name": "Product row" }]
}
{% endschema %}
