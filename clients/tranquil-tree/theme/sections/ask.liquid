{%- comment -%} "Questions?" box with a WhatsApp link. On a product page the message names the product. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign title = s.heading
  assign msg = s.message
  if product
    assign title = title | replace: '[product]', product.title
    assign msg = msg | replace: '[product]', product.title
  else
    assign title = title | replace: ' [product]', '' | replace: '[product]', ''
  endif
-%}
{%- if settings.whatsapp != blank -%}
<section class="sec" style="padding-top:0">
  <div class="wrap">
    <div class="ask">
      <div><h2 class="h2">{{ title }}</h2>{% if s.text != blank %}<p>{{ s.text }}</p>{% endif %}</div>
      <a class="btn btn-y" href="{% render 'href', fallback: 'whatsapp', text: msg %}" target="_blank" rel="noopener">{% render 'icon', name: 'whatsapp' %} {{ s.btn }}</a>
    </div>
  </div>
</section>
{%- elsif request.design_mode -%}
<div class="wrap"><p class="empty-coll">Add Kiki's WhatsApp number in Theme settings to show the Questions box.</p></div>
{%- endif -%}

{% schema %}
{
  "name": "WhatsApp questions",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions about [product]?", "info": "[product] becomes the product name." },
    { "type": "text", "id": "text", "label": "Text", "default": "Send Kiki a WhatsApp. The message already names this product." },
    { "type": "text", "id": "message", "label": "Ready-typed message", "default": "Hi Kiki, I have a question about [product]." },
    { "type": "text", "id": "btn", "label": "Button", "default": "WhatsApp Kiki" }
  ],
  "presets": [{ "name": "WhatsApp questions" }]
}
{% endschema %}
