<section class="trust" aria-label="{{ section.settings.label | escape }}">
  <div class="wrap">
    <ul>
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li {{ block.shopify_attributes }}>
          <span class="ico">{% render 'icon', name: b.icon %}</span>
          <div><strong>{{ b.title }}</strong><span>{%- if b.link_text != blank -%}<a href="{% render 'href', url: b.link, fallback: b.special %}">{{ b.link_text }}</a> {% endif -%}{{ b.text }}</span></div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Trust strip",
  "tag": "div",
  "settings": [ { "type": "text", "id": "label", "label": "Section name (for screen readers)", "default": "Delivery and help" } ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
        { "value": "truck", "label": "Truck" }, { "value": "shield-check", "label": "Shield" }, { "value": "whatsapp", "label": "WhatsApp" },
        { "value": "repeat", "label": "Repeat" }, { "value": "package", "label": "Package" }, { "value": "heart", "label": "Heart" }, { "value": "star", "label": "Star" }
      ] },
      { "type": "text", "id": "title", "label": "Title", "default": "Title" },
      { "type": "text", "id": "link_text", "label": "Link text (optional, goes before the text)" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "select", "id": "special", "label": "If the link is empty, use", "default": "custom", "options": [
        { "value": "custom", "label": "Nothing" }, { "value": "whatsapp", "label": "WhatsApp" }, { "value": "shift", "label": "Shift Consultation link" }
      ] },
      { "type": "text", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [{ "name": "Trust strip", "blocks": [
    { "type": "item", "settings": { "icon": "truck", "title": "Delivered to your door", "text": "Across South Africa in 3–5 days, R120 flat rate" } },
    { "type": "item", "settings": { "icon": "shield-check", "title": "Safe checkout", "text": "Payments are handled by Shopify's secure checkout." } },
    { "type": "item", "settings": { "icon": "whatsapp", "title": "Questions before you buy?", "link_text": "WhatsApp Kiki", "special": "whatsapp", "text": "and she will help you choose." } }
  ] }]
}
{% endschema %}
