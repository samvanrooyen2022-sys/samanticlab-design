{%- comment -%} Pins in place while the tiles travel sideways as you scroll. {%- endcomment -%}
{%- assign tiles = section.blocks | where: 'type', 'tile' -%}
<section class="travel" data-travel aria-labelledby="h-{{ section.id }}">
  <div class="travel-stage">
    <div class="wrap travel-head">
      <h2 class="h2" id="h-{{ section.id }}"{% if settings.motion %} data-words{% endif %}>{{ section.settings.heading }}</h2>
      {%- if tiles.size > 1 -%}<span class="travel-count" data-travel-count data-total="{{ tiles.size }}">1 of {{ tiles.size }}</span>{%- endif -%}
    </div>
    <div class="travel-track" data-track>
      {%- for block in tiles -%}
        {%- assign c = block.settings.collection -%}
        {%- capture tile_url -%}{%- if block.settings.link != blank -%}{{ block.settings.link }}{%- elsif c != blank -%}{{ c.url }}{%- elsif block.settings.group != blank -%}{{ routes.all_products_collection_url }}#{{ block.settings.group }}{%- elsif block.settings.search != blank -%}{% render 'search-url', q: block.settings.search, title: block.settings.title %}{%- else -%}#{%- endif -%}{%- endcapture -%}
        <a class="tile" href="{{ tile_url }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="ph has-img">{{ block.settings.image | image_url: width: 900 | image_tag: class: 'pi', widths: '400,600,900', sizes: '(min-width: 768px) 400px, 78vw', loading: 'lazy', alt: block.settings.title | default: c.title }}</div>
          {%- elsif c.featured_image != blank -%}
            <div class="ph has-img">{{ c.featured_image | image_url: width: 900 | image_tag: class: 'pi', widths: '400,600,900', sizes: '(min-width: 768px) 400px, 78vw', loading: 'lazy', alt: c.title }}</div>
          {%- elsif block.settings.search != blank -%}
            <div class="ph {{ block.settings.tone }}" data-thumb-src="{{ routes.search_url }}?type=product&q={{ block.settings.search | url_encode }}&section_id=search-thumb">{% render 'icon', name: block.settings.icon %}</div>
          {%- else -%}
            <div class="ph {{ block.settings.tone }}">{% render 'icon', name: block.settings.icon %}<span class="ph-cap">{{ block.settings.title | default: c.title }} photo</span></div>
          {%- endif -%}
          <div class="tile-name"><h3>{{ block.settings.title | default: c.title | default: 'Collection' }}</h3><span class="go">{% render 'icon', name: 'arrow-right' %}</span></div>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
        </a>
      {%- endfor -%}
      {%- assign more = section.blocks | where: 'type', 'more_link' -%}
      {%- if more.size > 0 -%}
        <div class="tile-more">
          {%- for block in more -%}
            <a href="{%- if block.settings.link != blank -%}{{ block.settings.link }}{%- elsif block.settings.group != blank -%}{{ routes.all_products_collection_url }}#{{ block.settings.group }}{%- elsif block.settings.search != blank -%}{% render 'search-url', q: block.settings.search, title: block.settings.label %}{%- else -%}{% render 'href', fallback: block.settings.special %}{%- endif -%}" {{ block.shopify_attributes }}>{{ block.settings.label }} {% render 'icon', name: 'arrow-right' %}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="travel-progress" aria-hidden="true"><i></i></div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by what you need",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by what you need" }
  ],
  "blocks": [
    { "type": "tile", "name": "Tile", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "image_picker", "id": "image", "label": "Photo", "info": "Empty uses the collection's own image." },
      { "type": "text", "id": "title", "label": "Title", "info": "Empty uses the collection name." },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "text", "id": "group", "label": "Or open a group on the shop page", "info": "Its anchor name, e.g. drinks. See the Group blocks on the shop page." },
      { "type": "text", "id": "search", "label": "Search words", "info": "Finds the tile's photo when there's no collection or photo. Also where the tile goes if nothing above is set. Use OR between words." },
      { "type": "url", "id": "link", "label": "Link", "info": "Empty goes to the collection, or the search above." },
      { "type": "select", "id": "icon", "label": "Icon while there's no photo", "default": "leaf", "options": [
        { "value": "zap", "label": "Bolt" }, { "value": "activity", "label": "Pulse" }, { "value": "droplet", "label": "Drop" },
        { "value": "brain", "label": "Brain" }, { "value": "heart", "label": "Heart" }, { "value": "leaf", "label": "Leaf" }, { "value": "star", "label": "Star" }
      ] },
      { "type": "select", "id": "tone", "label": "Empty photo colour", "default": "soft", "options": [
        { "value": "soft", "label": "Soft" }, { "value": "p", "label": "Sage green" }
      ] }
    ] },
    { "type": "more_link", "name": "Extra link", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "More" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "text", "id": "group", "label": "Or open a group on the shop page", "info": "Its anchor name, e.g. drinks. See the Group blocks on the shop page." },
      { "type": "text", "id": "search", "label": "If the link is empty, search for", "info": "Use OR between words." },
      { "type": "select", "id": "special", "label": "Or use", "default": "custom", "options": [
        { "value": "custom", "label": "Nothing" }, { "value": "bestsellers", "label": "Best-sellers" }
      ] }
    ] }
  ],
  "presets": [{ "name": "Shop by what you need", "blocks": [
    { "type": "tile", "settings": { "title": "Energy", "icon": "zap" } },
    { "type": "tile", "settings": { "title": "Body", "icon": "activity" } },
    { "type": "tile", "settings": { "title": "Skin", "icon": "droplet" } },
    { "type": "tile", "settings": { "title": "Mindset", "icon": "brain" } }
  ] }]
}
{% endschema %}
