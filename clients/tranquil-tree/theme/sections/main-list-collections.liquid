<div class="wrap">
  <div class="shop-top"><h1 class="sig">{{ section.settings.heading }}</h1></div>
  <div class="shop-grid" style="padding-block:24px 72px">
    {%- for c in collections -%}
      {%- if c.products_count == 0 -%}{%- continue -%}{%- endif -%}
      <a class="tile" href="{{ c.url }}" style="width:auto">
        {%- if c.featured_image -%}<div class="ph has-img">{{ c.featured_image | image_url: width: 800 | image_tag: class: 'pi', widths: '300,500,800', sizes: '(min-width: 768px) 33vw, 50vw', loading: 'lazy' }}</div>{%- else -%}<div class="ph">{% render 'icon', name: 'leaf' %}</div>{%- endif -%}
        <div class="tile-name"><h3>{{ c.title }}</h3><span class="go">{% render 'icon', name: 'arrow-right' %}</span></div>
      </a>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{ "name": "Collections list", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" } ] }
{% endschema %}
