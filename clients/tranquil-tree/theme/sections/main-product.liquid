{%- comment -%}
  Product page. Left: swipeable photos. Right: blocks you can add, remove and
  reorder in the theme editor (title, price, picker, add to cart, Kiki's note…).
{%- endcomment -%}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign crumb = collection | default: product.collections.first
  assign media_count = product.media.size
-%}
<div class="wrap" data-product data-product-id="{{ product.id }}">
  {%- if crumb -%}
    <nav class="crumbs" aria-label="You are here"><a href="{{ routes.root_url }}">Home</a>{% render 'icon', name: 'chevron-right' %}<a href="{{ crumb.url }}">{{ crumb.title }}</a></nav>
  {%- endif -%}
  <div class="pdp">
    <div class="gallery">
      <div class="gallery-track" data-gallery>
        {%- for m in product.media -%}
          {%- case m.media_type -%}
            {%- when 'video' -%}
              <div class="ph has-img">{{ m | video_tag: class: 'pi', controls: true, muted: true, playsinline: true, image_size: '1000x' }}</div>
            {%- when 'external_video' -%}
              <div class="ph has-img ext">{{ m | external_video_tag: class: 'pi' }}</div>
            {%- else -%}
              {%- if forloop.first -%}{%- assign eager = 'eager' -%}{%- else -%}{%- assign eager = 'lazy' -%}{%- endif -%}
              <div class="ph has-img" data-media-id="{{ m.id }}">{{ m.preview_image | image_url: width: 1400 | image_tag: class: 'pi', widths: '400,600,800,1000,1400', sizes: '(min-width: 1024px) 55vw, 88vw', loading: eager, alt: m.alt | default: product.title }}</div>
          {%- endcase -%}
        {%- else -%}
          <div class="ph">{% render 'icon', name: 'image' %}<span class="ph-cap">Add a product photo in Shopify</span></div>
        {%- endfor -%}
      </div>
      {%- if media_count > 1 -%}
        <div class="dots" data-dots>{% for m in product.media %}<button type="button" aria-label="Photo {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>{% endfor %}</div>
      {%- endif -%}
    </div>

    <div class="buy">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            <h1 {{ block.shopify_attributes }}>{{ product.title }}</h1>
          {%- when 'price' -%}
            <div class="top" {{ block.shopify_attributes }}>{% render 'price', product: product, variant: current %}</div>
          {%- when 'does' -%}
            <p class="does" {{ block.shopify_attributes }}>{% render 'product-does', product: product, words: 30 %}</p>
          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="variant-picker" data-variant-picker {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  {%- assign oi = forloop.index0 -%}
                  <fieldset class="opts">
                    <legend>{{ option.name }}</legend>
                    <div class="opt-row">
                      {%- for value in option.values -%}
                        <label><input type="radio" name="opt-{{ oi }}" value="{{ value | escape }}" data-opt="{{ oi }}"{% if option.selected_value == value %} checked{% endif %}><span>{{ value }}</span></label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </div>
            {%- endunless -%}
          {%- when 'buy_buttons' -%}
            {%- form 'product', product, class: 'buy-form', data-product-form: '' -%}
              <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
              <div class="buy-row" {{ block.shopify_attributes }}>
                <div class="qty"><button type="button" aria-label="One less" data-pq="-1">{% render 'icon', name: 'minus' %}</button><span data-pq-val>1</span><button type="button" aria-label="One more" data-pq="1">{% render 'icon', name: 'plus' %}</button></div>
                <input type="hidden" name="quantity" value="1" data-pq-input>
                <button class="btn btn-wide btn-main" type="submit" data-main-add{% unless current.available %} disabled{% endunless %}><span class="btn-t" data-add-label>{% if current.available %}{{ b.label }}{% else %}Sold out{% endif %}</span></button>
              </div>
            {%- endform -%}
          {%- when 'delivery' -%}
            <div class="ship-line" {{ block.shopify_attributes }}>
              {%- if b.line_1 != blank -%}<p>{% render 'icon', name: 'truck' %} {{ b.line_1 }}</p>{%- endif -%}
              {%- if b.line_2 != blank -%}<p>{% render 'icon', name: 'shield-check' %} {{ b.line_2 }}</p>{%- endif -%}
            </div>
          {%- when 'why' -%}
            {%- assign why = product.metafields.custom.why_kiki.value | default: product.metafields.custom.why_kiki | default: b.fallback -%}
            {%- if why != blank -%}
              <div class="why" {{ block.shopify_attributes }}>
                <div class="ph clip">{%- if b.avatar != blank -%}{{ b.avatar | image_url: width: 200 | image_tag: class: 'pi', loading: 'lazy', alt: 'Kiki' }}{%- else -%}<img class="pi" src="{{ 'kiki.webp' | asset_url }}" alt="Kiki" width="192" height="192" loading="lazy">{%- endif -%}</div>
                <div>
                  <h2>{{ b.heading }}</h2>
                  <p>{{ why }}</p>
                </div>
              </div>
            {%- endif -%}
          {%- when 'accordion' -%}
            {%- liquid
              assign body = blank
              case b.source
                when 'description'
                  assign body = product.description
                when 'metafield'
                  assign parts = b.metafield | split: '.'
                  assign mf = product.metafields[parts[0]][parts[1]]
                  if mf.type == 'rich_text_field'
                    assign body = mf | metafield_tag
                  else
                    assign body = mf.value | default: mf
                  endif
                when 'text'
                  assign body = b.text
                when 'delivery'
                  capture body
                    echo '<p>' | append: settings.delivery_line | append: '</p>'
                    if shop.refund_policy
                      echo '<p><a href="' | append: shop.refund_policy.url | append: '">Returns policy</a></p>'
                    endif
                  endcapture
              endcase
            -%}
            {%- if body != blank -%}
              <details class="acc"{% if b.open %} open{% endif %} {{ block.shopify_attributes }}>
                <summary>{{ b.heading }} {% render 'icon', name: 'plus' %}</summary>
                <div class="rte">{{ body }}</div>
              </details>
            {%- endif -%}
          {%- when 'liquid' -%}
            <div {{ block.shopify_attributes }}>{{ b.code }}</div>
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<div class="sticky-buy" data-sticky-buy aria-hidden="true">
  <div class="meta"><b>{{ product.title }}</b>{% render 'price', product: product, variant: current %}</div>
  <button class="btn btn-add" type="button" data-sb-add{% unless current.available %} disabled{% endunless %}><span class="btn-t">Add to cart</span></button>
</div>

<script type="application/json" data-variants>{{ product.variants | json }}</script>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "class": "pdp-sec",
  "settings": [
    { "type": "paragraph", "content": "Blocks on the right can be reordered, removed or added. Product text comes from Shopify. Fill in the metafields custom.does (one line) and custom.why_kiki (Kiki's note) per product for the best result." }
  ],
  "blocks": [
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "does", "name": "What it does (one line)", "limit": 1 },
    { "type": "variant_picker", "name": "Flavour or size picker", "limit": 1 },
    { "type": "buy_buttons", "name": "Add to cart", "limit": 1, "settings": [
      { "type": "text", "id": "label", "label": "Button", "default": "Add to cart" }
    ] },
    { "type": "delivery", "name": "Delivery lines", "settings": [
      { "type": "text", "id": "line_1", "label": "Line 1", "default": "Delivered in 3–5 days, R120" },
      { "type": "text", "id": "line_2", "label": "Line 2", "default": "Secure checkout by Shopify" }
    ] },
    { "type": "why", "name": "Why Kiki uses it", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Why Kiki uses it" },
      { "type": "textarea", "id": "fallback", "label": "Text when the product has no note of its own", "info": "Each product's own note comes from the metafield custom.why_kiki. Leave this empty to hide the box on products without a note." },
      { "type": "image_picker", "id": "avatar", "label": "Kiki's photo" }
    ] },
    { "type": "accordion", "name": "Fold-out", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "What's in it" },
      { "type": "select", "id": "source", "label": "Content", "default": "description", "options": [
        { "value": "description", "label": "Product description" },
        { "value": "metafield", "label": "A product metafield" },
        { "value": "text", "label": "The text below" },
        { "value": "delivery", "label": "Delivery and returns" }
      ] },
      { "type": "text", "id": "metafield", "label": "Metafield (namespace.key)", "default": "custom.how_to_use" },
      { "type": "richtext", "id": "text", "label": "Text" },
      { "type": "checkbox", "id": "open", "label": "Open to start with", "default": false }
    ] },
    { "type": "liquid", "name": "Custom code", "settings": [ { "type": "liquid", "id": "code", "label": "Code" } ] },
    { "type": "@app" }
  ]
}
{% endschema %}
