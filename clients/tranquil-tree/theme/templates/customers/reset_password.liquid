<div class="wrap acct">
  <h1 class="sig">Choose a new password</h1>
  {%- form 'reset_customer_password', class: 'acct-form' -%}
    {{ form.errors | default_errors }}
    <label>New password<input type="password" name="customer[password]" autocomplete="new-password" required></label>
    <label>Confirm password<input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
    <button class="btn btn-wide" type="submit">Save password</button>
  {%- endform -%}
</div>
