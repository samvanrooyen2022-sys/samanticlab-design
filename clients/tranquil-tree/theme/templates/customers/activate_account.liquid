<div class="wrap acct">
  <h1 class="sig">Activate your account</h1>
  {%- form 'activate_customer_password', class: 'acct-form' -%}
    {{ form.errors | default_errors }}
    <label>Password<input type="password" name="customer[password]" autocomplete="new-password" required></label>
    <label>Confirm password<input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
    <button class="btn btn-wide" type="submit">Activate</button>
  {%- endform -%}
</div>
