<div class="wrap acct">
  <h1 class="sig">Hi {{ customer.first_name | default: 'there' }}</h1>
  <p><a href="{{ routes.account_addresses_url }}">Your addresses ({{ customer.addresses_count }})</a> · <a href="{{ routes.account_logout_url }}">Sign out</a></p>
  <h2 class="h2" style="margin-top:32px">Your orders</h2>
  {%- paginate customer.orders by 20 -%}
    {%- for order in customer.orders -%}
      <div class="line-item">
        <span class="ph">{% render 'icon', name: 'package' %}</span>
        <div><h3><a href="{{ order.customer_url }}">Order {{ order.name }}</a></h3><small>{{ order.created_at | date: '%-d %B %Y' }} · {{ order.fulfillment_status_label }}</small>
          <div class="reorder-items">{% for li in order.line_items limit: 3 %}{% if li.product %}<a class="text-link" href="{{ li.product.url }}">Order {{ li.title }} again</a>{% endif %}{% endfor %}</div>
        </div>
        <span class="price">{{ order.total_price | money }}</span>
      </div>
    {%- else -%}
      <p class="lede">No orders yet. <a href="{{ routes.all_products_collection_url }}">Start shopping</a>.</p>
    {%- endfor -%}
  {%- endpaginate -%}
</div>
