<div class="wrap acct">
  <p class="crumbs"><a href="{{ routes.account_url }}">Your account</a></p>
  <h1 class="sig">Your addresses</h1>
  {%- paginate customer.addresses by 10 -%}
    {%- for address in customer.addresses -%}
      <div class="line-item" style="grid-template-columns:1fr auto">
        <div>{{ address | format_address }}{% if address == customer.default_address %}<small>Default</small>{% endif %}</div>
        <form method="post" action="{{ address.url }}"><input type="hidden" name="_method" value="delete"><button class="btn btn-line btn-add" type="submit">Delete</button></form>
      </div>
    {%- endfor -%}
  {%- endpaginate -%}
  <h2 class="h2" style="margin-top:32px">Add an address</h2>
  {%- form 'customer_address', customer.new_address, class: 'acct-form' -%}
    {{ form.errors | default_errors }}
    <label>First name<input type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></label>
    <label>Last name<input type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></label>
    <label>Address<input type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></label>
    <label>Apartment, suite<input type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></label>
    <label>City<input type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></label>
    <label>Province<input type="text" name="address[province]" value="{{ form.province }}" autocomplete="address-level1"></label>
    <label>Country<select name="address[country]" autocomplete="country">{{ all_country_option_tags }}</select></label>
    <label>Postal code<input type="text" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></label>
    <label>Phone<input type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></label>
    <label class="check"><input type="checkbox" name="address[default]" value="1"><span class="box">{% render 'icon', name: 'check' %}</span><span class="lbl">Make this my default address</span></label>
    <button class="btn btn-wide" type="submit">Save address</button>
  {%- endform -%}
</div>
