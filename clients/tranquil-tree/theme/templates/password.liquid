{%- layout none -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {% render 'theme-styles' %}
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  {{ content_for_header }}
</head>
<body>
  <main class="links"><div class="links-in" style="text-align:center">
    <img src="{{ 'logo.webp' | asset_url }}" alt="{{ shop.name | escape }}" width="277" height="74" style="margin:0 auto 24px">
    <p class="links-intro">{{ shop.password_message | default: 'Something new is on its way.' }}</p>
    {%- form 'storefront_password' -%}
      {{ form.errors | default_errors }}
      <label class="sr" for="pw">Password</label>
      <div class="signup-row" style="border:2px solid var(--green)"><input id="pw" type="password" name="password" placeholder="Password" autocomplete="current-password"><button class="btn btn-ink" type="submit">Enter</button></div>
    {%- endform -%}
  </div></main>
</body>
</html>
